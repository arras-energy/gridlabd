// verify the sequence numbers are initialized and incremented correctly

class test {
    int16 seqid;
}

global int32 SEQ_A 0;
object test:..10 {
	name `test_{SEQ_A:INC}`;
    seqid `{SEQ_A}`;
}

#set savefile=${modelname/.glm/.json}

#on_exit 0 test $(grep '"seqid": "[0-9]"' < ${modelname/.glm/.json} | cut -f4 -d'"' | tr -d \\n) == "123456789"
