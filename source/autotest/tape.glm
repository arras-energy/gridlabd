// recorder.glm

#set pythonpath=..:.
module tape;

class recorder
{
	char1024 property;
	char1024 file;
	double interval[s];
	int16 flush;

	on_init "python:tape.recorder_init";
	on_commit "python:tape.recorder_commit";
}

class player
{
	char1024 property;
	char1024 file;
	int32 loop;
	char32 dtformat;

	on_init "python:tape.player_init";
	on_precommit "python:tape.player_precommit";
}
