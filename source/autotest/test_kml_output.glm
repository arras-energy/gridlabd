// test_kml_output.glm
#set threadcount=1
#set randomseed=1
#set relax_naming_rules=1

clock { 
	timezone EST+5EDT; 
	starttime '2000-06-02 0:00:00'; 
	stoptime '2000-06-04 0:00:00'; 
} 

class node
{
	enumeration {SWING=0} bustype;
	enumeration {ABCN=0} phases;
	complex voltage_A;
	complex voltage_B;
	complex voltage_C;
	double nominal_voltage;
}

object node 
{
	name node1; 
	bustype SWING; 
	phases ABCN; 
	voltage_A +7199.558+0.000j; 
	voltage_B -3599.779-6235.000j; 
	voltage_C -3599.779+6235.000j; 
	nominal_voltage 7200; 
	latitude 12N34.00056; 
	longitude 12W34.00056; 
}

#option kml=test_kml_output.kml

#ifexist "../test_kml_output.kml"
#on_exit 0 diff -I '    <name>' ../test_kml_output.kml test_kml_output.kml > gridlabd.diff
#endif
