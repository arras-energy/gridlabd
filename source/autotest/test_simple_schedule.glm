// test schedule transforms

#include "pandas.glm"

#set randomseed=1

clock 
{
	timezone "PST+8PDT";
	starttime "2009-01-01 0:00:00 PST";
	stoptime "2009-01-08 0:00:00 PST";
}

class house 
{
	loadshape occupancy;
}

object house 
{
	occupancy "type: scheduled; weekdays: MTWRF; on-time: 7<8~0.1<9; off-time: 17";
	object recorder
	{
		file "test_simple_schedule.csv";
		property occupancy;
		timezone "America/Los_Angeles";
	};
}

#ifexists "../test_simple_schedule.csv"
#on_exit 0 diff ../test_simple_schedule.csv test_simple_schedule.csv > gridlabd.diff
#endif
