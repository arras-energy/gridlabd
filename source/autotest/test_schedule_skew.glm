#include "pandas.glm"
#include "assert.glm"

#ifexists "../test_schedule_skew.glm"
#define DIR=..
#endif

clock 
{
	timezone "PST+8PDT";
	starttime "2016-01-01 00:00:00 PST";
	stoptime "2016-01-02 00:00:00 PST";
}

class test
{
	double x;
}

schedule skewed_schedule
{
	0-29 * * * * 0.0;
	30-59 * * * * 1.0;
}

object test 
{
	name runTimeClass;
	schedule_skew -12;
	x skewed_schedule*1+0.0;
	object assert 
	{
		target x;
		object player 
		{
			property value;
			file "${DIR:-.}/test_schedule_skew_1.csv";
			timezone "America/Los_Angeles";
		};
		relation EQ;
		within 0.00001;
	};
}

object test 
{
	name runTimeClass2;
	schedule_skew 25;
	x skewed_schedule*1.0+0.0;
	object assert 
	{
		target x;
		object player 
		{
			property value;
			file ${DIR:-.}/test_schedule_skew_2.csv;
			timezone "America/Los_Angeles";
		};
		relation EQ;
		within 0.00001;
	};
}
