// test whether ticket:114 is fixed

#set randomseed=1

#set module_compiler_flags=VERBOSE|DEBUG|KEEPWORK|CLEAN
#set force_compile=1
#include <math.h>

// run example for 1 day
clock {
	timezone PST+8PDT;
	starttime '2009-01-01 00:00:00 PST';
	stoptime '2009-01-01 01:00:00 PST';
}

// implement a deterministic noise source and signal target
class noise {
	double source; // deterministic source
	double signal; // destination for the noisy signal
	intrinsic presync(TIMESTAMP t0, TIMESTAMP t1)
	{
		// This provides the main noise source input.
		// You can source this from either the clock (t0)
		// or the elasping simulation time (t0-starttime)
		// or some other deterministic source you like.
		source += (double)rand() / RAND_MAX - 0.5; // random walk
		signal = source + ( (double)rand() / RAND_MAX - 0.5 ) / 10; // noise added
		return t0+10; // update signal every 10 seconds
	};
}

#ifexist "../tape.glm"
#define DIR=..
#on_exit 0 diff ../test_c_include.csv test_c_include.csv > gridlabd.diff
#endif

#include "${DIR:-.}/tape.glm"

// record the output
object noise 
{
	source 100;
	name "noise";
	object recorder 
	{
		file "test_c_include.csv";
		property "source,signal";
	};
}
