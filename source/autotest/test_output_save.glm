#include "pandas.glm"

clock 
{
    timezone "US/CA/Los Angeles";
    starttime "2020-01-01 00:00:00 PST";
    stoptime "2021-01-01 00:00:00 PST";
}

class house
{
    randomvar air_temperature[degF];
}

object house
{
    air_temperature "type:uniform(72,74); refresh:1h";
    object recorder
    {
        file "test_output_save.csv";
        property "air_temperature";
        interval "1h";
    };
}

#output "test_output_save.png"

#assert -f test_output_save.png