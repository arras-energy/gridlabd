#set randomseed=1

clock {
	starttime '2001-01-01 0:00:00';
	stoptime '2001-01-02 0:00:00';
}

class test {
	randomvar x;
}

#include "pandas.glm"

object test 
{
	x "type:normal(0,1); refresh:60";
	object recorder 
	{
		property x;
		interval 1h;
		file "test_notz.csv";
	};
}

#ifexist "../test_notz.csv";
#on_exit 0 diff ../test_notz.csv test_notz.csv > gridlabd.diff
#endif
