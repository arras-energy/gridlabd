// $Id: test_global_unit_convert.glm 4738 2014-07-03 00:55:39Z dchassin $

#include "assert.glm"

global double test_double[degF] 0.0 degC;

#print ${test_double}

object assert 
{
	target "test_double";
	relation EQ;
	dtype float;
	value 32.0;
	within 0.01;
}

global complex test_complex[V] 12+1j kV; // default 0+0j unit kVA description "Test value";

object assert 
{
	target "test_complex";
	relation EQ;
	dtype complex;
	value 12000+0d;
	within 100.0;
}

