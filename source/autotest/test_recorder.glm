#ifexist "../tape.glm"
#define DIR=..
#on_exit 0 diff ../test_recorder.csv test_recorder.csv > gridlabd.diff
#endif

#include "${DIR:-.}/tape.glm"

clock
{
	starttime "2020-01-01 00:00:00 UTC";
	stoptime "2020-01-01 01:00:00 UTC";
}

class test
{
	char8 str;
	randomvar x[MW];
	randomvar y[MVAr];
}

object test
{
	str "1,2,3";
	x "type:normal(0,2);min:0;refresh:10s";
	y "type:normal(0,1);refresh:10s";
	object recorder
	{
		property "str,x,y";
		file "test_recorder.csv";
		interval 1h;
	};
}
