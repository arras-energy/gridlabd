// Filter test simple delay
//

#set verbose=TRUE
//#set debug=TRUE
#set randomseed=123

clock {
    timezone "PST+8PDT";
    starttime "2000-01-01 00:00:00 PST";
    stoptime "2000-01-01 00:11:00 PST";
}

filter delay(z,5min,10s,resolution=8,minimum=-1,maximum=1) = 1/z;

class from {
    randomvar value;
}

object from {
    name from;
    value "type:normal(0,1); refresh:1min";
}

class to {
    double value;
}

object to {
    name to;
    value delay(from:value);
}

#include "pandas.glm"

object recorder {
    file ${modelname/.glm/.csv};
    interval -1;
    property "from:value,to:value";
}

#include "assert.glm"

object assert {
    parent to;
    start '2000-01-01 00:00:00 PST';
    stop '2000-01-01 00:05:09 PST';
    target value;
    dtype float;
    relation EQ;
    value 0.0;
    within 1e-4;
}

object assert {
    parent to;
    start '2000-01-01 00:05:10 PST';
    stop '2000-01-01 00:10:09 PST';
    target value;
    dtype float;
    relation EQ;
    value -1.0;
    within 1e-4;
}
