// test of ticket:496
#include "pandas.glm"

#set randomseed=1

clock {
	timezone "EST+5EDT";
	starttime "2000-01-01 00:00:00 EST";
	stoptime "2000-01-01 00:01:00 EST";
}

class my_test {
	randomvar x;
	randomvar y;
}

object my_test:..2 {
	x "type:uniform(0,1); refresh:1s";
	y "type:uniform(0,1); refresh:1s";
	object recorder {
		property x,y;
		file `test_statefull_randomization_{id}.csv`;
		interval -1;
		timezone "America/New_York";
	};
}

#ifexists "../test_statefull_randomization_1.csv"
#on_exit 0 diff ../test_statefull_randomization_1.csv test_statefull_randomization_1.csv > gridlabd_1.diff
#on_exit 0 diff ../test_statefull_randomization_3.csv test_statefull_randomization_3.csv > gridlabd_3.diff
#endif