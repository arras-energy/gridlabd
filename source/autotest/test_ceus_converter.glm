class ceus
{
    char1024 filename;
    double floor_area[sf];
    double total_real_power[W];
    double total_reactive_power[W];
    complex total_power_A[W];
    complex total_power_B[W];
    complex total_power_C[W];
}

#ifexist ../test_ceus_converter.json
#define DIR=..
#on_exit 0 test "$(gridlabd json-get objects building floor_area < test_ceus_converter.json)" == "15000 sf"
#else
#define DIR=.
#endif

#input "${DIR}/test_ceus_converter_opt.csv" -f ceus -t ceus -p name=building -p floor_area=15000sf

#set savefile=test_ceus_converter.json

