// Test script dump of clock to json

clock {
	timezone EST+5EDT;
	starttime '2000-01-01 00:00:00 EST';
	stoptime '2000-01-02 02:00:00 EST';
}

class test {
	double test_var;
}

object test {
	test_var 1.23;
}

script on_term gridlabd:dump test_clock_json.json;

#on_exit 0 test "$(gridlabd json-get globals clock value < test_clock_json.json)" == "$(gridlabd json-get globals starttime value < test_clock_json.json)"
