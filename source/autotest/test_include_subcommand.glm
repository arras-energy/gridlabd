#ifexist ../test_include_subcommand.txt
#define DIR=..
#endif

#include (cat ${DIR:-.}/test_include_subcommand.txt)

#include "assert.glm"

object test
{
    x 12;
    z 12+2j;
    object assert {
        status TRUE;
        target x;
        relation EQ;
        value 12;
    };
    object assert {
        status TRUE;
        target z.real;
        relation EQ;
        value 12;
    };
    object assert {
        status TRUE;
        target z.imag;
        relation EQ;
        value 2;
    };
}

