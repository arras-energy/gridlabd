// verify that clock can read ISO format timestamps
#include "pandas.glm"
#include "assert.glm"

#set dateformat=ISO8601

clock 
{
	timezone "EST+5EDT";
	starttime "2000-01-01T00:00:00-05:00";
	stoptime "2000-01-02T02:00:00-05:00";
}

class test 
{
	double test_var;
};

class climate 
{
 	randomvar clouds;
} 

object climate
{
	clouds "type:weibull(0.5,0.5); min:0.0; max:1.0; refresh:1h;";
}

object test 
{
	name Test;	
};

script on_term gridlabd:dump test_iso_datetime.json;

#ifexist "../test_iso_datetime.py"
#on_exit 0 python3 ../test_iso_datetime.py
#endif

