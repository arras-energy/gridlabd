// test_core_player_schedule_1.glm makes sure an unparented player
// can serve as a schedule and work with transforms. the schedule is used
// in a house object

#set minimum_timestep=1;

#ifexist "../pandas.glm"
#define DIR=..
#endif

#include "${DIR:-.}/pandas.glm"

clock
{
	timezone PST+8PDT;
	starttime '2000-01-01 00:00:00';
	stoptime '2000-01-03 02:00:00';
}

class test
{
	double x;
}

object test
{
	object player
	{
		name source;
		file "${DIR:-.}/test_core_player_schedule_1.csv";
		property x;
		loop 2;
	};
	object recorder
	{
		property x;
		file "test_core_player_schedule_2.csv";
	};
}

