script export clock;

script on_create "echo create done >test_script_event.txt";
script on_init "echo init done >>test_script_event.txt";
#ifdef WINDOWS
script on_sync "echo sync done at %clock% >>test_script_event.txt";
#else
script on_sync "echo sync done at $clock >>test_script_event.txt";
#endif
script on_term "echo term done >>test_script_event.txt";

clock {
	starttime '2000-01-01 00:00:00';
	stoptime '2000-01-01 00:01:00';
}
class test {
	randomvar x;
}
object test {
	name test1;
	x "type:normal(0,1); refresh:1h";
}

#ifexist ../test_script_event.txt
#on_exit 0 diff ../test_script_event.txt test_script_event.txt > gridlabd.diff
#endif	
