// test the @ syntax for inheriting a property value from another object

#include "assert.glm"

class test
 {
     double x;
 }
 object test
 {
     name test1;
     x 8.88;
 }
 object test
 {
     name test2;
     x @test1;
     object assert{
        target x;
        relation EQ;
        value 8.88;
     };
 }