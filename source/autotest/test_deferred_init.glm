// check that deferred initialization works as required

#set pythonpath=.:..
module test_deferred_init;

clock {
	timezone "PST+8PDT";
	starttime "2000-01-01 00:00:00";
	stoptime "2000-01-01 01:00:00";
}

class test
{
	bool done;
}

object test
{
	done FALSE;
	on_init "python:test_deferred_init.init";
}
