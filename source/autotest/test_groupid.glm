// $Id: test_groupid.glm 4738 2014-07-03 00:55:39Z dchassin $
// 
// Test groupid function

#set randomseed=1

clock 
{
	timezone PST+8PDT;
	starttime '2000-01-01 00:00:00 PST';
	stoptime '2000-01-31 23:59:59 PST';
}

class test
{
	randomvar x;
}

object test:..100
{
	groupid A;
	x "type:uniform(0,1), refresh:1h";
}

object test:..12 
{
	groupid B;
	x "type:uniform(0,1), refresh:1h";
}

#include "pandas.glm"

object collector 
{
	group "class=='test' and groupid=='A'";
	property "x.count,x.len,x.sum,x.prod,x.min,x.max,x.argmin,x.argmax,x.mean,x.avg,x.average,x.std,x.stdev,x.var,x.skew,x.kurt";
	limit 10;
	interval 3600;
	dtformat "%Y-%m-%d %H:%M:%S";
	file "test_groupid.csv";
}

#ifexists "../test_groupid.csv"
#on_exit 0 diff ../test_groupid.csv test_groupid.csv > gridlabd.diff
#endif
