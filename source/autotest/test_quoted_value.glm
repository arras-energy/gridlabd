// $Id: test_quoted_value.glm 4738 2014-07-03 00:55:39Z dchassin $
// Test of quoted value parsing
//

class test
{
	char32 value;
}

object test
{
	value "front" "back";
}

object test
{
	value """front" "back""";
}

#write test_quoted_value.json

#on_exit 0 test "$(gridlabd json-get objects test:0 value < test_quoted_value.json)" == 'front back'
#on_exit 0 test "$(gridlabd json-get objects test:1 value < test_quoted_value.json)" == 'front" "back'
