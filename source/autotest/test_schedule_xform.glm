// test schedule transforms

#include "pandas.glm"

clock 
{
	timezone PST+8PDT;
	starttime '2009-01-01 0:00:00 PST';
	stoptime '2009-01-02 0:00:00 PST';
}

schedule test_schedule 
{
	0-29 * * * * 0;
	30-59 * * * * 1;
}

class test 
{
	double my_double;
}

object test 
{
	my_double test_schedule*2.58+1;
	object recorder 
	{
		property "my_double";
		file "test_schedule_xform.csv";
	};
}

#ifexists "../test_schedule_xform.csv"
#on_exit 0 diff ../test_schedule_xform.csv test_schedule_xform.csv > gridlabd.diff
#endif