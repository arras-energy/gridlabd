#include "assert.glm"
#include "pandas.glm"

clock {
	starttime "2020-01-01 00:00:00";
	stoptime "2020-01-01 01:00:00";
}
class test
{
	double var; // TODO: this isn't reliable for doubles (see below)
}

object test
{
	var "1.0";
	object assert
	{
		target "var";
		relation EQ;
		value 2.0;
	};
	object recorder
	{
		property "var";
		interval 30 min;
		file "test_modify.csv";
	};
}

#ifexist "../test_modify_opt.csv"
#define DIR=..
#on_exit 0 diff ../test_modify.csv test_modify.csv > gridlabd.diff
#endif

#input "${DIR:-.}/test_modify_opt.csv" -f modify -t modify

