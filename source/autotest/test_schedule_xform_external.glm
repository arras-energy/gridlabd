// test schedule transforms

#set randomseed=17
#set module_compiler_flags=VERBOSE|DEBUG|KEEPWORK|CLEAN
#set force_compile=1

extern "C" test_schedule_xform_external : myfunction2@1 // inline code follows
{
	int myfunction2(int nlhs, GLXDATA *plhs, int nrhs, GLXDATA *prhs)
	{	/* make sure the correct number of args are passed in */
		if ( nlhs!=1 || nlhs!=1 ) return -1;
		/* subtract 5 from arg */
		GLXdouble(plhs[0]) = GLXdouble(prhs[0]) - 5;
		return 0;
	}	
} // end inline code

// DPC: removed because validate.py does not handle such external dependencies well
// extern "C" extern_test : myfunction, myfunction1; // only first one is defined in test_extern_function (tests warning)

#include "assert.glm"
#include "pandas.glm"

clock {
	timezone PST+8PDT;
	starttime '2009-01-01 0:00:00 PST';
	stoptime '2009-01-02 0:00:00 PST';
}

schedule test_schedule {
	0-29 * * * * 0
	30-59 * * * * 1
}

schedule test_schedule_inv {
	0-29 * * * * 1
	30-59 * * * * 0
}

class test {
	double x1;
	double x2;
	double x3;
	double x4;
}

class player
{
	double value;
}

#ifexists "../test_schedule_xform_external.csv"
#define DIR=..
#endif

object player 
{
	parent "test1";
	name "test_schedule_xform_external";
	file "${DIR:-.}/test_schedule_xform_external.csv";
}

object recorder
{
	parent "test1";
	property "x1,x2,x3,x4";
	file "test_schedule_xform_external_out.csv";
}

object test 
{

	name "test1";
	
	// transform references property in as-yet undefined object
	// this results in an expected warning about an unknown source type
	x1 test2.x1+1;
	
	// transform references property in this object
	x2 myfunction2(x1);
	
	// transform references schedule
	x3 test_schedule+70;
	
	// transform references player
	x4 test_schedule_xform_external.value;	
}

object test
{
	name "test2";
	x1 1.23;
}

#ifexists "../test_schedule_xform_external_out.csv"
#on_exit - diff ../test_schedule_xform_external_out.csv test_schedule_xform_external_out.csv > gridlabd.diff
#endif
