// test_cvx_lp.glm

#set suppress_repeat_messages=FALSE
#set randomseed=1

clock
{
  timezone America/Seattle;
  starttime "2020-08-01 00:00:00 PST";
  stoptime "2020-09-01 00:00:00 PST";
}

module optimize
{
  cvx_failure_handling WARN;
  cvx_problemdump "${modelname/.glm/.txt}";
}

#define M=2
#define N=2
#define P=1

class input
{
#for m in ${RANGE $M}
  randomvar p${m};
#done
#for n in ${RANGE $N}
  randomvar q${n};
#done
}

class output
{
  double x;
}

module tape
{
  csv_header_type NAME;
}

#define m=${RANGE $M}
#define n=${RANGE $N}
#define PROPERTIES=p=p${m/ /,p},q${n/ /,q}

object input:..${N}
{
  parent "quadratic-program";
#for m in ${RANGE $M}
  p${m} "type:normal(0,1);refresh:1h";
#done
#for n in ${RANGE $N}
  q${n} "type:normal(0,1);refresh:1h";
#done
  object recorder
  {
    file `${modelname/.glm/.txt}_input_{id}.csv`;
    property ${PROPERTIES};
    interval -1;
  };
}

object output:..${M}
{
  parent "quadratic-program";
  x 0.0;
  object recorder
  {
    file `${modelname/.glm/.txt}_output_{id}.csv`;
    property "x";
    interval -1;
  };
}

#define m=${RANGE $M}
#define n=${RANGE $N}

object cvx
{
  name "quadratic-program";
  event SYNC;
  data "~p=input:p0,input:p1";
  data "~q=input:q0,input:q1";
  variables "x=output:x";
  presolve """
    if not 'P' in dir(): # initial solve
      np.random.seed(1)
      G = np.random.randn(1,2)
      h = np.random.randn(1)
      A = np.random.randn(1,2)
      b = np.random.randn(1)
    P = (p.T @ p).value
  """;
  objective "Minimize((1/2)*quad_form(x,P) + q.T @ x)";
  constraints """
    G @ x <= h,
    A @ x == b
    """;
}

#set savefile=${modelname/.glm/.json}

