module pypower
{
    message_flags VERBOSE;
}
module tape
{
    csv_header_type NAME;
}

#set output_message_context=NONE
#option verbose

object bus
{
    object gen
    {
        object powerplant
        {
            operating_capacity 100 MW;
            weather weather;
            Tnominal 15 degC;
            Tcutoff 45 degC;
            derating 1 %/degC;
            status ONLINE;
        };
        object recorder
        {
            file test_derating_powerplant_capacity;
            property Pmax,Qmax;
            interval 0;
        };
    };
}

object weather
{
    name weather;
    Td 10 degC;
    object player
    {
        file test_derating_weather.csv;
    };
}

#set savefile=${modelname/.glm/.json}
