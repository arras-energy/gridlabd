# Syntax: gridlabd-apm [OPTIONS ...] COMMAND PACKAGE
__doc__="""GridLAB-D Arras package manager

Syntax: gridlabd apm COMMAND [ARGUMENTS ...]

Commands
--------

    - `install PACKAGE [...]`:  install package(s)

Options
-------

    - `--verbose`:  enable verbose output

Description
-----------

  The Arras package manager maintain Arras Energy packages used by gridlabd.

Example
-------

The following command install the converters.

    gridlabd apm install converters
"""

import os
import sys
import gridlabd_subcommand as gls

SOURCE = "https://raw.githubusercontent.com/arras-energy/{package}/refs/heads/master/install.sh"
"""Source URL for packages"""

VERBOSE = False
"""Enable verbose output"""

DEBUG = False
"""Enable traceback on exceptions"""

QUIET = False
"""Enable suppression of all unnecessary output"""

WARNING = True
"""Enable warning output"""

def main(argv:list[str]=None):
    """Main installer for Arras Package Manager (APM)

    Arguments
    ---------

    - `argv`: installer command arguments (see `gridlabd-apm`)
    """
    if argv is None:
        argv = sys.argv

    options = [x for x in argv[1:] if x.startswith("-")]
    for option in options:

        match option:

            case "--debug":

                global DEBUG
                DEBUG = True

            case "--quiet":

                global QUIET
                QUIET = True

            case "--verbose":

                global VERBOSE
                VERBOSE = True

            case "--warning":

                global WARNING
                WARNING = True

            case "_":

                raise gls.SubcommandSyntaxError(f"{option=} is invalid")

    args = [x for x in argv if not x.startswith("-")]
    gls.check_syntax(__doc__,args=args,nargs=2)
    command = args[1]
    packages = args[2:]

    match command:

        case "help":

            print(__doc__)

        case "install":
        
            for package in packages:
                url = SOURCE.format(package=package)
                redir = "" if VERBOSE else "1>/dev/null 2>&1"
                if os.system(f"curl -sL {url} | sh {redir}"):
                    print(f"ERROR [gridlabd-apm]: {package=} install failed")
        
        case "_":
        
            raise gls.SubcommandSyntaxError(f"{command=} is invalid")

if __name__ == '__main__':
    
    try:

        main()

    except gls.SubcommandSyntaxError as err:

        if not QUIET:
            print(err,file=sys.stderr)
        sys.exit(gls.E_SYNTAX)

    except:

        e_type,e_value,_ = sys.exc_info()
        print(f"EXCEPTION [gridlabd-apm]: {e_type} {e_value}",file=sys.stderr)

        if DEBUG:
            raise
        else:
            sys.exit(gls.E_EXCEPTION)
