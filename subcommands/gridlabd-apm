# Syntax: gridlabd-apm [OPTIONS ...] COMMAND PACKAGE
__doc__="""GridLAB-D Arras package manager

Syntax: gridlabd apm COMMAND [ARGUMENTS ...]

Commands
--------

    - `install PACKAGE [...]`:  install package(s)

Options
-------

    - `--verbose`:  enable verbose output

Description
-----------

  The Arras package manager maintain Arras Energy packages used by gridlabd.

Example
-------

The following command install the converters.

    gridlabd apm install converters
"""

import os
import sys
import gridlabd_subcommand as gls

gls.EXENAME = "gridlabd-apm"

SOURCE = "https://raw.githubusercontent.com/arras-energy/{package}/refs/heads/master/install.sh"
"""Source URL for packages"""

# TODO: replace this with a search of the arras-energy repos
EXTENSIONS = [
    "converters",
    "tools",
    ]
"""List of supported python extension packages"""

# TODO: replace this with a search of the arras-energy/modules repo
MODULES = [
    "assert",
    "behavior",
    "commercial",
    "climate",
    "generators",
    "industrial",
    "influxdb",
    "market",
    "mysql",
    "optimize",
    "powerflow",
    "pypower"
    "reliability",
    "residential",
    "resilience",
    "revenue",
    "tape",
    "tape_file",
    "tariff",
    ]

def extension(name:str):
    """Install a python extension for Arras Energy

    Arguments
    ---------

    - `package`: the package repository name
    """
    url = SOURCE.format(package=name)
    redir = "" if gls.VERBOSE else "1>/dev/null 2>&1"
    gls.verbose(f"downloading extension '{name}' from {url=}",file=sys.stderr)
    if os.system(f"""curl -sL -H "Cache-Control: no-cache, no-store, must-revalidate" {url}" | sh {redir}"""):
        gls.error(f"extension '{name}' install failed")
    elif os.system(f"python3 -m {name}.__init__"):
        gls.error(f"extension '{name}' init failed")

def module(name:str):

    url = SOURCE.format(package="gridlabd-modules")
    redir = "" if gls.VERBOSE else "1>/dev/null 2>&1"
    gls.verbose(f"building module '{name}' from {url=}",file=sys.stderr)
    if os.system(f"""curl -sL -H "Cache-Control: no-cache, no-store, must-revalidate" "{url}" | sh -s {name} {redir}"""):
        gls.error(f"module '{name}' install failed")

def main(argv:list[str]=None):
    """Main installer for Arras Package Manager (APM)

    Arguments
    ---------

    - `argv`: installer command arguments (see `gridlabd-apm`)
    """
    if argv is None:
        argv = sys.argv

    options = [x for x in argv[1:] if x.startswith("-")]
    for option in options:

        match option:

            case "--debug":

                gls.DEBUG = True

            case "--quiet":

                gls.ERROR = False

            case "--verbose":

                gls.VERBOSE = True

            case "--warning":

                gls.WARNING = True

            case "_":

                gls.exception(ValueError,f"{option=} is invalid")

    args = [x for x in argv if not x.startswith("-")]
    gls.check_syntax(__doc__,args=args,nargs=2)
    command = args[1]
    items = args[2:]

    match command:

        case "help":

            gls.output(__doc__)

        case "install":
        
            if not items:

                gls.exception(ValueError,"no install items specified")

            for item in items:
                if item in EXTENSIONS:
                    extension(item)

                elif item in MODULES:
                    module(item)

                else:
                    gls.exception(ValueError,f"'{item}' is not a valid package or module")
        
        case "_":
        
            gls.exception(ValueError,f"{command=} is invalid")

if __name__ == '__main__':
    
    try:

        main()

    except gls.SubcommandSyntaxError as err:

        gls.error(err,exitcode=gls.E_SYNTAX)

    except SystemExit as err:

        sys.exit(err)

    except:

        e_type,e_value,_ = sys.exc_info()
        if gls.DEBUG:
            raise
        else:
            gls.exception(e_type,e_value)
        sys.exit(gls.E_EXCEPTION)
