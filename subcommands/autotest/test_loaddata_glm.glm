#include "pandas.glm"

clock 
{
    timezone "PST+8PDT";
    starttime "2018-01-01 00:00:00 PST";
    stoptime "2019-01-01 00:00:00 PST";
}

class test
{
    double electricity[kWh];
    double natural_gas[kBtu];
}

object test
{
    object player 
    {
        file "${modelname/.glm/.csv}";
    };
    object recorder
    {
        file "${modelname/.glm/_out.csv}";
        property "electricity,natural_gas";
        interval 0;
    };
}

