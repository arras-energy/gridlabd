GLM:

    #project [OPTIONS ...] COMMAND [ARGUMENTS ...]

DESCRIPTION

    The 'gridlabd project' command manage GridLAB-D projects in GitHub.

OPTIONS

    -b|--branch BRANCH       Specify the repository BRANCH
    -d|--debug               Enable debug output and exception traceback
    -h|--help|help           Display this help information
    -o|--org ORG             Specify the GitHub ORG
    -q|--quiet               Disable error output
    -r|--repo REPO           Specify the GitHub REPO
    -v|--verbose             Enable verbose output
    -w|--warning             Disable warning output

COMMANDS

    create PROJECT   Create and open a new project
    config
      show           Show the current configuration
      save           Save options are default configuration
    edit PROJECT     Open an existing project
    save MESSAGE     Save project to github

EXAMPLE

"""

import sys, os
import json

E_OK = 0
E_SYNTAX = 1
E_INVALID = 2
E_NOTFOUND = 3
E_MISSING = 4
E_EXISTS = 5
E_EXCEPTION = 9

_COMMANDS = ["create","edit","config","save","list"]

def list(workdir=None):

    if workdir is None:
        workdir = settings["workdir"]
    for item in os.listdir(workdir):
        itempath = os.path.join(workdir,item)
        if not item.startswith(".") and os.path.isdir(itempath):
            list(itempath)
        ok = True
        for required in [".git","notebook.py"]:
            if not os.path.exists(os.path.join(itempath,required)):
                ok = False
        if ok: 
            print(itempath)

def create(project):

    # create work folder in workdir
    workdir = settings["workdir"]
    project_path = os.path.join(workdir,project)
    if os.path.exists(os.path.join(project_path)):
        error(f"{project=} exists in {workdir=}",E_EXISTS)
    verbose(f"creating {project=} in {workdir=}...")
    os.makedirs(project_path)
    os.chdir(project_path)
    verbose(f"...ok")

    # git init the folder
    if os.system("git init"):
        raise RuntimeError("git init failed")

    # copy template files from GitHub
    if settings["template"]:
        warning(f"unable to copy template files from {settings['template']}")

    # edit the project
    return edit(project)

def edit(project):

    # edit the project in Marimo notebook
    workdir = settings["workdir"]
    project_path = os.path.join(workdir,project)
    if not os.path.exists(os.path.join(project_path)):
        error(f"{project=} does not exist in {workdir=}",E_NOTFOUND)
    verbose(f"opening {project=} in {workdir=} with marimo...")
    os.chdir(project_path)
    os.system(f"marimo edit notebook.py")
    verbose(f"...ok")

def config(command,*args,**kwargs):

    global settings
    file = sys.argv[0].replace(".py",".conf")
    
    if command == "show":
    
        if kwargs:

            error(f"{kwargs=} is invalid",E_INVALID)

        if args:

            for key in args:

                print(f"{key}={settings[key]}")

            return E_OK

        for key,value in settings.items():
            print(f"{key}={value}")
        return E_OK
    
    if command == "load":
        try:
            with open(file,"r") as fh:
                settings = json.load(fh)
        except:
            settings = dict(
                workdir = os.path.join(os.environ["HOME"],"github"),
                show = False,
                quiet = False,
                warning = True,
                debug = None,
                verbose = False,
                exception = False,
                template = "arras-energy/.project",
                )
        return E_OK

    if command == "set":

        if args:

            error(f"{args=} is invalid",E_INVALID)

        if not kwargs:

            error("missing key=value",E_MISSING)

        for key,value in kwargs:

            settings[key] = eval(value)

        return E_OK

    if command == "save":
    
        with open(file,"w") as fh:
            json.dump(settings,fh)
        
        return E_OK

    error(f"{command=} is not a valid config command",E_INVALID)

def save(message):

    verbose(f"TODO save({message=})")

def exception(msg=None,code=None):
    """Print exception message

    Exception messages are printed only if the configuration parameter `exception` is false.
    Otherwise, the exception is raised. Use the '-e|--exception' option to toggle this setting.

    PARAMETERS

        msg (None or str)    Exception message (None to get last exception)
        code (None or int)   Exit code. None does not exit. Default is None)
    """
    if settings["exception"]:
        raise
    if not msg:
        e_type, e_value, e_trace = sys.exc_info()
        if settings["debug"]:
            import traceback
            msg = "".join(traceback.format_exception(e_type,e_value,e_trace))
        else:
            msg = e_value
        code = E_EXCEPTION
    print(f"EXCEPTION [gridlabd-project]: {msg}",file=sys.stderr)
    if type(code) is int:
        exit(code)

def error(msg,code=None):
    """Print error message

    Error messages are printed only if the configuration parameters `quiet` is false.
    Otherwise, the error message is suppressed. Use the '-q|--quiet' option to toggle this setting.

    PARAMETERS

        msg (str)            Error message
        code (None or int)   Exit code. None does not exit. Default is None)
    """
    if not settings["quiet"]:
        print(f"ERROR [gridlabd-project]: {msg}",file=sys.stderr)
    if type(code) is int:
        exit(code)

def warning(msg):
    """Print warning message

    Warning messages are printed only if the configuration parameter `warning` is true.
    Otherwise the warning message is suppressed. Use the '-w|--warning' option to toggle this setting.

    PARAMETERS

        msg (str)   Warning message
    """
    if settings["warning"]:
        print(f"WARNING [gridlabd-project]: {msg}",file=sys.stderr)

def verbose(msg):
    """Print verbose message

    Verbose messages are printed only if the configuration parameter `verbose`
    is true. Otherwise the verbose message is suppressed. Use
    the '-v|--verbose' option to toggle this setting.

    If msg ends with ... then the final carriage return is not output. If the
    msg starts with ... then the initial heading is not output and the
    leading ... is suppressed.

    PARAMETERS

        msg (str)   Verbose message
    """
    if settings["verbose"]:
        heading = "VERBOSE [gridlabd-project]: " if not msg.startswith("...") else ""

        print(f"{heading}{msg[(0 if heading else 3):]}",end="..." if msg.endswith("...") else "\n",file=sys.stderr)

def debug(msg,level=0):
    """Print debug message

    Debug messages are printed only if the configuration parameter `debug` is an integer and the
    value of level is less than or equal to the `debug` value. Otherwise the debug message is 
    suppressed. Use the '-d|--debug' option to toggle this setting.

    PARAMETERS

        msg (str)     Debug message
        level (int)   Debug message level (default is 0)
    """
    if settings["debug"] and level <= config["debug"]:
        print(f"DEBUG [gridlabd-project]: (level {level}) {msg}",file=sys.stderr)

def output(msg,code=None):
    """Print output message

    Output messages are printed only if the configuration parameter `quiet` is false.
    Otherwise the output message is suppressed. Use the '-q|--quiet' option to toggle this setting.

    PARAMETERS

        msg (str)    Output message
        code (int)   Exit code to use after message is output (use `None` to not exit)
    """
    print(msg,file=sys.stdout)
    if type(code) is int:
        exit(code)

def main(argv):

    global settings
    config("load")

    os.chdir(settings["workdir"])

    if len(argv) == 1:
        print(__doc__)
        exit(E_SYNTAX)

    args = []
    kwargs = {}

    command = None

    for arg in argv[1:]:
        
        if arg in _COMMANDS:

            command = globals()[arg]
            continue

        if arg in ["-h","--help","help"]:

            output(__doc__,E_OK)

        if "=" in arg:

            tag,value = arg.split("=",1)

        else:

            tag,value = arg,None

        if tag in ["-d","--debug"]:

            if value:
                if value.upper() in ["T","TRUE","Y","YES"]:
                    settings['debug'] = True
                elif value.upper() in ["F","FALSE","N","NO"]:
                    settings['debug'] = False
                else:
                    try:
                        settings['debug'] = (int(value)!=0)
                    except:
                        error(f"debug={repr(value)} is invalid")
            else:
                settings['debug'] = not settings['debug']

        elif tag in ["-v","--verbose"]:

            settings['verbose'] = not settings['verbose']

        elif tag in ["-q","--quiet"]:

            settings['quiet'] = True

        elif tag in ["-w","--warning"]:

            settings['warning'] = not settings['warning']

        elif command:

            if value:
                kwargs[tag] = value
            else:
                args.append(tag)

        else:

            error(f"option {arg} is not valid",E_INVALID)

    if command:

        exit(command(*args,**kwargs))

    else:

        error("no command",E_MISSING)

if __name__ == "__main__":

    main(sys.argv)
