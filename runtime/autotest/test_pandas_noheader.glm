// test_pandas.glm

#include "pandas.glm"

// #set debug=TRUE
// #set verbose=TRUE

#ifexists ../test_pandas_noheader.csv
#define DIR=..
#else
#define DIR=.
#endif

clock
{
	timezone "PST+8PDT";
	starttime "2000-01-01 00:00:00 PST";
	stoptime "2000-01-02 00:00:00 PST";
}

class test
{
	double x;
}

object test
{
	object player
	{
		file "${DIR}/test_pandas_noheader.csv";
		timezone "America/Los_Angeles";
		property "x";
	};
	object recorder
	{
		file "test_pandas_noheader_out.csv";
		property "x";
		interval -1;
	};
}

#ifexists "../test_pandas_noheader_out.csv"
#on_exit 0 diff "../test_pandas_noheader_out.csv" "test_pandas_noheader_out.csv" > gridlabd.diff
#endif
