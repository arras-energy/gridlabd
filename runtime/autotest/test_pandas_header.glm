// test_pandas.glm

#include "pandas.glm"

// #set debug=TRUE
// #set verbose=TRUE

#ifexists ../test_pandas_header.csv
#define DIR=..
#else
#define DIR=.
#endif

clock
{
	timezone "PST+8PDT";
	starttime "2000-01-01 00:00:00 PST";
	stoptime "2000-01-02 00:00:00 PST";
}

class test
{
	bool b;
	enumeration {a=0,b=1,c=2} e;
	set {none=0,a=1,b=2,c=4} f;
	int16 i;
	int32 j;
	int64 k;
	double x;
	complex z;
	string s;
}

object test
{
	object player
	{
		file "${DIR}/test_pandas_header.csv";
		timezone "America/Los_Angeles";
	};
	object recorder
	{
		file "test_pandas_header_out.csv";
		property "b,e,f,i,j,k,x,z,s";
		timezone "America/Los_Angeles";
		dtformat "%Y-%m-%d %H:%M:%S %Z";
	};
}

#ifexists "../test_pandas_header_out.csv"
#on_exit 0 diff "../test_pandas_header_out.csv" "test_pandas_header_out.csv" > gridlabd.diff
#endif
