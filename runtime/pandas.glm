// pandas.glm
//
// Include this GLM file to load player and recorder classes
//

module glm_pandas;

class recorder
{
	string property;
	string file;
	double interval[s];
	string timezone;
	string dtformat;
	enumeration {NONE=0,INLINE=1,HEADER=2} units;
	bool flush;
	int32 limit;

	on_init "python:glm_pandas.recorder_init";
	on_commit "python:glm_pandas.recorder_commit";
}

class player
{
	string property;
	string file;
	string timezone;
	python options;

	on_init "python:glm_pandas.player_init";
	on_precommit "python:glm_pandas.player_precommit";
}

class collector
{
	string group;
	string property;
	string file;
	double interval[s];
	string timezone;
	string dtformat;
	enumeration {NONE=0,INLINE=1,HEADER=2} units;
	bool flush;
	int32 limit;

	on_init "python:glm_pandas.collector_init";
	on_commit "python:glm_pandas.collector_commit";
}
