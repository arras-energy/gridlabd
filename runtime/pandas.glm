// pandas.glm
//
// Include this GLM file to enable pandas players and recorders
//

module gld_pandas;

class recorder
{
	string property;
	string file;
	double interval[s];
	string timezone;
	string dtformat;
	bool flush;

	on_init "python:gld_pandas.recorder_init";
	on_commit "python:gld_pandas.recorder_commit";
}

class player
{
	string property;
	string file;
	string timezone;
	python options;

	on_init "python:gld_pandas.player_init";
	on_precommit "python:gld_pandas.player_precommit";
}
