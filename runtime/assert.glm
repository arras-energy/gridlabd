// assert.glm
//
// Include this GLM file to load assert class
//

module glm_assert;

class assert
{
    string target;
    enumeration {EQ=0,LT=1,LE=2,GT=3,GE=4,NE=5,IN=6,NI=7} relation;
    string value;
    string dtype;
    double within;
    string lower;
    string upper;
    //string group;
    timestamp start;
    timestamp stop;
    enumeration {INIT=0,TRUE=1,FALSE=2,ERROR=3,WAITING=4,STOPPED=5} status;
    enumeration {ERROR=0,WARNING=1,EXCEPTION=2,IGNORE=3} on_failure;

    on_init "python:glm_assert.assert_init";
    on_commit "python:glm_assert.assert_commit";
}
